# Copy to .env (or let install.sh generate it)
ZEFIRA_ADMIN_USERNAME=admin
ZEFIRA_ADMIN_PASSWORD=change-me-please

# Public domain used inside generated configs / subscription links
#ZEFIRA_DOMAIN=vpn.example.com
#ZEFIRA_SUB_PORT=443
#ZEFIRA_HY2_PORT=8443
#ZEFIRA_WG_PORT=51820
#ZEFIRA_DNS=1.1.1.1
#ZEFIRA_OVPN_PORT=1194
#ZEFIRA_OVPN_PROTO=udp

# Session lifetime in seconds (default 8h)
#ZEFIRA_SESSION_TTL=28800

# Comma separated IPs/CIDRs allowed to send X-Forwarded-For
#ZEFIRA_TRUSTED_PROXIES=

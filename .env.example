# Copy to .env (or let install.sh generate it)
ZEFIRA_ADMIN_USERNAME=admin
# ONE-TIME ONLY: used to create the first admin, then auto-scrubbed from
# .env on first boot. Change it from Settings after login; do not keep it here.
ZEFIRA_ADMIN_PASSWORD=change-me-please

# Public domain used inside generated configs / subscription links
#ZEFIRA_DOMAIN=vpn.example.com
#ZEFIRA_SUB_PORT=443
#ZEFIRA_HY2_PORT=8443
#ZEFIRA_WG_PORT=51820
#ZEFIRA_DNS=1.1.1.1
#ZEFIRA_OVPN_PORT=1194
#ZEFIRA_OVPN_PROTO=udp

# Database - leave empty for SQLite (default), or set full URL:
# SQLite:  (default) instance/zefira.db
# MySQL/MariaDB:  mysql+pymysql://user:pass@127.0.0.1:3306/zefira
# PostgreSQL:     postgresql+psycopg2://user:pass@127.0.0.1:5432/zefira
#DATABASE_URL=

# Subscription link prefix (default /sub)
#SUBSCRIPTION_PATH=/sub

# Session lifetime in seconds (default 8h)
#ZEFIRA_SESSION_TTL=28800

# Comma separated IPs/CIDRs allowed to send X-Forwarded-For.
# Hardened: 0.0.0.0/0, multicast, and overly-broad ranges (< /8 v4, < /32 v6)
# are refused at input AND ignored at runtime (XFF spoofing = rate-limit bypass).
# Example for local Nginx: ZEFIRA_TRUSTED_PROXIES=127.0.0.1
#ZEFIRA_TRUSTED_PROXIES=

# Updates: pinned to mrlurix/zefira-panel@main. Set to 0 to disable the
# in-panel updater entirely (hardened installs). Custom mirrors require
# ZEFIRA_ALLOW_CUSTOM_REPO=1 (otherwise env overrides are ignored).
#ZEFIRA_ALLOW_UPDATE=1
#ZEFIRA_ALLOW_CUSTOM_REPO=0

# Telegram (optional)
#TG_BOT_TOKEN=
#TG_CHAT_ID=
